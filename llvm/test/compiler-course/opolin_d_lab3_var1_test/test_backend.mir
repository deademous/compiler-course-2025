    ; CHECK: %2:vr128 = COPY $xmm2
    ; CHECK-NEXT: %1:vr128 = COPY $xmm1
    ; CHECK-NEXT: %0:vr128 = COPY $xmm0
    ; CHECK-NEXT: %3:vr128 = VPXORrr %0, %1 ; xor.i = a ^ b
    ; CHECK-NEXT: %4:vr128 = VPANDrr %3, %2  ; and.i = xor.i & c
    ; CHECK-NEXT: $xmm0 = COPY %4
    ; CHECK-NEXT: RET 0, $xmm0

    %2:vr128 = COPY $xmm2
    %1:vr128 = COPY $xmm1
    %0:vr128 = COPY $xmm0
